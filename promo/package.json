{
  "name": "laixin-promo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx LaixinPromo out/laixin-promo.mp4",
    "render:no-bgm": "remotion render src/index.tsx LaixinPromo out/laixin-promo-no-bgm.mp4 --props=props-no-bgm.json",
    "check": "tsc --noEmit",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.484"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "playwright": "1.64.1",
    "typescript": "6.0.3"
  }
}
